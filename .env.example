# HMS-Victory Configuration
DISCORD_TOKEN=
OPENAI_TOKEN=
GEMINI_TOKEN=
CHROME_PATH=/usr/bin/google-chrome-stable
# First installs only: permits init_db to create an empty database when database.db
# is absent. Leave false during normal operation so a failed restore stops startup.
# Disable immediately after the first successful bootstrap.
ALLOW_EMPTY_DB_BOOTSTRAP=false
