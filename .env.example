# HMS-Victory Configuration
DISCORD_TOKEN=
OPENAI_TOKEN=
GEMINI_TOKEN=
CHROME_PATH=/usr/bin/google-chrome-stable
# First installs only: permits init_db to create an empty database and allows empty
# JSON state when their live paths are absent. Leave false during normal operation
# so a failed database or JSON restore stops startup.
# Disable immediately after the first successful bootstrap.
ALLOW_EMPTY_DB_BOOTSTRAP=false
# Add any other config vars here
